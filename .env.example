# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (optional: without these, store orders are placed as "Pay at pickup")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Terminal card reader for the pharmacy POS (optional)
# Register a reader in Stripe Dashboard > Terminal, then paste its id (tmr_...)
# With a test key (sk_test_...) you can use a simulated reader.
STRIPE_TERMINAL_READER_ID=

# SMS + WhatsApp (Twilio) - optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Country code used for local numbers that start with 0 (0300... -> +92300...). Default 92.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=92

# Email (Resend) - optional
RESEND_API_KEY=
EMAIL_FROM="CarePlus Hospital <hello@yourdomain.com>"

# Automations scheduler secret (any long random string). Protects /api/cron/automations.
# Run supabase/09_automation_scheduler.sql to call it every 5 minutes.
CRON_SECRET=

# Meta: WhatsApp Cloud API + Facebook Messenger + Instagram DMs in Admin > Chats
# Token: Meta Business Settings > System users > generate token with whatsapp_business_messaging,
#        whatsapp_business_management, pages_messaging, pages_manage_metadata, instagram_manage_messages
META_ACCESS_TOKEN=
# App Dashboard > App settings > Basic > App secret (verifies webhooks)
META_APP_SECRET=
# Any string you choose; paste the same in the Meta webhook settings
META_VERIFY_TOKEN=
# Optional: default WhatsApp sender if you have not added numbers under Chats > Channels
META_WA_PHONE_NUMBER_ID=
# Optional: {"<page id>":"<page access token>"} if a Page needs its own token
META_PAGE_TOKENS=
# Optional: exact public URL Twilio calls, if different from NEXT_PUBLIC_SITE_URL/api/webhooks/twilio
TWILIO_WEBHOOK_URL=

# Insurance claims: where "Submit electronically" sends the claim JSON (clearinghouse / billing service / Zapier)
CLAIMS_WEBHOOK_URL=
CLAIMS_WEBHOOK_TOKEN=

# Lab analyzer / LIS interface: token your interface engine sends to /api/lab/hl7
LAB_INTERFACE_TOKEN=
